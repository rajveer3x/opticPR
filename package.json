{
  "name": "opticpr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.11.1 <27"
  },
  "scripts": {
    "db:generate": "pnpm --filter @opticpr/database generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "vitest run tests/unit.test.ts tests/github.unit.test.ts tests/publication.unit.test.ts tests/analysis.unit.test.ts tests/history.unit.test.ts tests/inline.unit.test.ts",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/integration.test.ts tests/github.integration.test.ts tests/publication.integration.test.ts tests/analysis.integration.test.ts tests/history.integration.test.ts --maxWorkers=1",
    "test:smoke": "node --env-file=.env scripts/smoke.mjs",
    "dev:api": "node --env-file=.env apps/api/dist/main.js",
    "dev:worker": "node --env-file=.env apps/worker/dist/main.js",
    "fixture:replay": "node --env-file=.env apps/worker/dist/replay.js",
    "run:inspect": "node --env-file=.env scripts/inspect.mjs",
    "publication:retry": "node --env-file=.env apps/worker/dist/retry-publication.js",
    "finding:decide": "node --env-file=.env apps/worker/dist/finding-decision.js",
    "check:outage": "node --env-file=.env scripts/check-outage.mjs",
    "analysis:benchmark": "node --env-file=.env apps/worker/dist/benchmark.js",
    "analysis:scanner:pull": "docker pull semgrep/semgrep:1.144.0@sha256:10301f060aacf84078f9704fb1ba3a321df4ac46b009fd29c1c66880d1db8e77"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
