DATABASE_URL=postgresql://opticpr:opticpr@127.0.0.1:54329/opticpr?schema=public&connect_timeout=3
REDIS_URL=redis://127.0.0.1:63799/0
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
REPLAY_TIMEOUT_MS=30000

# Optional: required only for live GitHub intake/publication. Keep the API behind a TLS reverse proxy.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# Paste the PEM as one quoted line with literal \n between lines.
GITHUB_APP_PRIVATE_KEY=

# Optional local inference; only loopback HTTP origins are accepted.
OLLAMA_URL=http://127.0.0.1:11434

# Authenticated dashboard. Use the GitHub App's Client ID and Client Secret.
# Register this exact callback: <DASHBOARD_ORIGIN>/auth/github/callback
# Local Vite development uses http://127.0.0.1:5173; production uses an HTTPS origin.
DASHBOARD_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# At least 32 random bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional local fixture HTTP inspection, disabled whenever DASHBOARD_ORIGIN is set.
FIXTURE_INSPECTION_ENABLED=0
